{
  "name": "clone-of-designed-to-scale",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch scripts/serve.js --dev",
    "start": "node scripts/serve.js",
    "build": "node scripts/check.js --build",
    "lint": "node scripts/check.js",
    "test": "node --test",
    "coverage": "node --experimental-test-coverage --test",
    "setup:course-board": "course-board vendor scripts/vendor/course-board.js",
    "predev": "npm run setup:course-board",
    "prelint": "npm run setup:course-board",
    "prebuild": "npm run setup:course-board"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@lprakashv/course-board": "https://github.com/lprakashv/course-board/releases/download/v0.1.1/lprakashv-course-board-0.1.1.tgz",
    "markdown-it": "^15.0.3",
    "roughjs": "4.6.6",
    "yaml": "^2.9.1"
  }
}
